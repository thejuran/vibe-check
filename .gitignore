# Ignore zip files (auto-generated skill packages)
*.zip

# Tool-owned working state (per fork architecture — .turingmind/ is gitignored;
# user cp's REVIEW.md somewhere persistent if they want it tracked)
.turingmind/

# GSD planning artifacts (kept out of the fork repo itself)
.planning/

# Milestone-orchestrator config (release_intent / skip_walkthrough etc.) — local
# operator state, must not drift into the repo as a committed release posture
.orchestrator.json

# Private design docs (spec/plan notes — kept local, not shared)
docs/superpowers/

# Local distribution aids — the prompts to hand a new user, not part of the plugin
SHARE-PROMPT*.md

# macOS Finder metadata
.DS_Store

# Python bytecode from the score.py test suite (plugins/vibe-check/scripts/)
# — compiled artifacts, not tracked; score.py + test_score.py themselves DO ship.
__pycache__/

# Phase-40 and Phase-41 spot-check session transcripts — kept on the owner's machine only. A Claude Code
# transcript carries the owner's private global instructions and account details verbatim; the
# run commit binds each one by its transcript.jsonl.sha256 instead.
docs/design/b3-ground-truth/runs-v2.10-phase40/**/transcript.jsonl
docs/design/b3-ground-truth/runs-v2.10-phase41/**/transcript.jsonl

# Phase-43 measurement transcripts — same rule.
docs/design/b3-ground-truth/runs-v2.10-phase43/**/transcript.jsonl

# Phase-49 measurement transcripts — same rule.
docs/design/b3-ground-truth/runs-v2.11-phase49/**/transcript.jsonl

# Phase-53 development-rehearsal transcripts — same rule (copied in for dev-tally's card count).
docs/design/reachability-dev/runs-phase53-dev/**/transcript.jsonl

# Repo-local Claude Code settings: absolute paths and the v2.12 holdout deny hook live here.
# Today it is ignored only by the owner's global gitignore; this line makes the repo itself
# guarantee it is never committed.
.claude/settings.local.json
# The guard's one-time backup of that file (same contents before the hook was added).
.claude/settings.local.json.pre-holdout.bak
